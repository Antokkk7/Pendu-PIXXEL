<?xml version="1.0" encoding="UTF-8"?>

<?import ihm.pendu.view.RetroBackground?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="800.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ihm.pendu.view.JeuPenduController">
   <children>
      <RetroBackground />
      <BorderPane>
         <top>
            <VBox alignment="CENTER" spacing="14" BorderPane.alignment="CENTER">
               <padding>
                  <Insets top="26.0" />
               </padding>
               <children>
                  <VBox alignment="CENTER" maxWidth="-Infinity" styleClass="word-panel">
                     <children>
                        <Label fx:id="LeMot" styleClass="word" />
                     </children>
                  </VBox>
                  <Label fx:id="ErreurChoix" styleClass="errors" />
               </children>
            </VBox>
         </top>
         <center>
            <VBox alignment="CENTER" spacing="10">
               <children>
                  <Region VBox.vgrow="ALWAYS" />
                  <HBox alignment="CENTER">
                     <children>
                        <GridPane fx:id="clavier" hgap="12" vgap="16" />
                     </children>
                  </HBox>
                  <Region VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </center>
         <bottom>
            <VBox alignment="CENTER" spacing="8.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="26.0" top="10.0" />
               </padding>
               <children>
                  <Label fx:id="ResultatChoix" styleClass="message" />
                  <Label fx:id="Reponse" styleClass="answer" />
                  <HBox alignment="CENTER" spacing="22.0">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                     <children>
                        <Button fx:id="Retour" mnemonicParsing="false" onAction="#loadAccueil" prefWidth="190.0" styleClass="btn-secondary" text="Revenir au menu" />
                        <Button mnemonicParsing="false" onAction="#resetGame" prefWidth="190.0" text="Reset la partie" />
                        <Button mnemonicParsing="false" onAction="#quiter" prefWidth="190.0" styleClass="btn-danger" text="Quitter la partie" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </bottom>
      </BorderPane>
   </children>
</StackPane>
