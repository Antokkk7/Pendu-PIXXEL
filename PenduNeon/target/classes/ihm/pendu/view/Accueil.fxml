<?xml version="1.0" encoding="UTF-8"?>

<?import ihm.pendu.view.NeonTitle?>
<?import ihm.pendu.view.RetroBackground?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="1080.0" maxWidth="1920.0" minHeight="270.0" minWidth="480.0" prefHeight="600.0" prefWidth="960.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ihm.pendu.view.AccueilController">
   <children>
      <RetroBackground />
      <BorderPane>
         <top>
            <MenuBar BorderPane.alignment="CENTER">
              <menus>
                <Menu mnemonicParsing="false" text="Choix">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#initializeNormal" text="Partie normale" />
                        <MenuItem mnemonicParsing="false" onAction="#initializeTriche" text="Partie &quot;Triche&quot;" />
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem mnemonicParsing="false" onAction="#quitter" text="Quitter" />
                     </items></Menu>
                <Menu mnemonicParsing="false" text="À propos">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#Regles" text="Comment jouer" />
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem mnemonicParsing="false" onAction="#Credit" text="Crédits" />
                        <MenuItem mnemonicParsing="false" onAction="#Version" text="Version" />
                     </items></Menu>
                  <Menu mnemonicParsing="false" text="?">
                    <items>
                      <MenuItem mnemonicParsing="false" onAction="#Scratch" text="hein ?" />
                    </items>
                  </Menu>
              </menus>
            </MenuBar>
         </top>
         <center>
            <HBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
               <children>
                  <ImageView fx:id="Tomate" fitHeight="120.0" fitWidth="150.0" nodeOrientation="RIGHT_TO_LEFT" pickOnBounds="true" preserveRatio="true" styleClass="gif-frame">
                     <image>
                        <Image url="@../gifs/Tomate.gif" />
                     </image>
                  </ImageView>
                  <VBox alignment="CENTER" spacing="22.0">
                     <children>
                        <NeonTitle fontSize="64.0" text="Pendu PiqueSel" />
                        <Label styleClass="subtitle" text="— PRESS SPACE —">
                           <VBox.margin>
                              <Insets bottom="14.0" />
                           </VBox.margin>
                        </Label>
                        <Button fx:id="PartieNormale" mnemonicParsing="false" onAction="#initializeNormal" prefHeight="54.0" prefWidth="320.0" styleClass="btn-primary" text="Partie normale" />
                        <Button fx:id="PartieTriche" mnemonicParsing="false" onAction="#initializeTriche" prefHeight="54.0" prefWidth="320.0" styleClass="btn-primary, btn-secondary" text="Partie simplifiée" />
                        <Button mnemonicParsing="false" onAction="#quitter" prefHeight="54.0" prefWidth="320.0" styleClass="btn-primary, btn-danger" text="Quitter" />
                     </children>
                  </VBox>
                  <ImageView fx:id="Cwinge" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" styleClass="gif-frame">
                     <image>
                        <Image url="@../gifs/Cwinge.gif" />
                     </image>
                  </ImageView>
               </children>
            </HBox>
         </center>
      </BorderPane>
   </children>
</StackPane>
